# OpenRouter：chat + Gemini Embedding 2 共用这一把 key
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat 模型 slug，覆盖 configs/default.yaml 的 llm.model
# 也可写成 OPENROUTER_MODEL=...
model=deepseek/deepseek-v4-flash-0731

# 可选：只给 Judge 换模型
# JUDGE_MODEL=anthropic/claude-sonnet-4

# 一般不用改；若走代理可覆盖
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
