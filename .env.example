# OpenRouter: chat judge and optional embeddings share this key
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model slug; overrides configs/default.yaml
# OPENROUTER_MODEL=google/gemini-2.5-flash
model=google/gemini-2.5-flash

# Optional: judge-only override
# JUDGE_MODEL=google/gemini-2.5-flash

# Native Gemini (use with --config configs/gemini.yaml)
# GEMINI_API_KEY=

# Optional: if prompts/dimensions.yaml is not found from the working directory
# ALPHAIDEABENCH_ROOT=/path/to/this/repo
